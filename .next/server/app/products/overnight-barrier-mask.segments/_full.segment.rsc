13:["$","section",null,{"className":"mt-20 md:mt-32 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16","children":[["$","div",null,{"className":"md:col-span-4","children":["$","p",null,{"className":"text-eyebrow text-muted-foreground mb-5","children":"Overview"}]}],["$","div",null,{"className":"md:col-span-8","children":["$","$L21",null,{"children":[["$","p",null,{"className":"font-serif text-xl md:text-2xl leading-[1.4] tracking-tight","children":"Overnight Barrier Mask is the final seal in a complete PM routine — and a recovery tool when skin feels compromised. A 5% ceramide complex, squalane and panthenol sit under a breathable occlusive matrix that prevents transepidermal water loss overnight. Wake to visibly calmer, more hydrated skin. Use two to three times weekly, or nightly on reactive skin."}],"$undefined"]}]}]]}]
