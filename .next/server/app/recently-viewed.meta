{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/recently-viewed/layout,_N_T_/recently-viewed/page,_N_T_/recently-viewed/"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/recently-viewed/__PAGE__",
    "/recently-viewed",
    "/_index",
    "/_head"
  ]
}