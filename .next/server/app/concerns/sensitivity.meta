{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/concerns/layout,_N_T_/concerns/[slug]/layout,_N_T_/concerns/[slug]/page,_N_T_/concerns/sensitivity/"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/concerns/$d$slug/__PAGE__",
    "/concerns/$d$slug",
    "/concerns",
    "/_index",
    "/_head"
  ]
}