# ============================================================================
# AUREL — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and configure for your environment.
# `.env` is gitignored and MUST NEVER be committed. Only `.env.example` is
# tracked. If you have previously committed a `.env` containing real secrets,
# rotate those credentials — removing the file from the current index does
# not remove its historical exposure.
# ============================================================================

# ---- Site URL (for SEO, sitemap, OG tags) ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Contact URL for the /case-study CTA ----
# Where the "START A PROJECT" button on /case-study links to.
NEXT_PUBLIC_CONTACT_URL=/contact

# ---- Commerce mode (REQUIRED) ----
# demo    — self-contained, no credentials, clearly-labelled demo checkout.
#           No payment, no real order, no real subscriptions. (default)
# shopify — live Shopify Storefront API. Authoritative product, variant, cart,
#           pricing and checkout. Requires the SHOPIFY_* vars below.
COMMERCE_MODE=demo

# ---- Static export / GitHub Pages (optional, demo mode) ----
# Set to "true" to build a static export for GitHub Pages.
# STATIC_EXPORT=true

# ---- GitHub Pages basePath (optional) ----
# Set to /<repo-name> when deploying to a project site (e.g. /aurel-commerce).
# NEXT_PUBLIC_BASE_PATH=/aurel-commerce

# ---- Shopify Storefront API (required when COMMERCE_MODE=shopify) ----
# A public Storefront API token is safe to use in the browser for unauthenticated
# read operations per Shopify's security model. A private token MUST stay
# server-side only — NEVER put it in a NEXT_PUBLIC_ variable.
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-token
# SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=your-private-storefront-token  # server-only
# SHOPIFY_API_VERSION=2025-07

# ---- Database (local dev only — demo mode uses an in-memory catalogue) ----
DATABASE_URL="file:./dev.db"

# ---- Analytics (optional) ----
# Analytics events are dispatched as window custom events in this demo.
# Wire this to your GA4 / PostHog / etc. measurement ID if needed.
# NEXT_PUBLIC_ANALYTICS_ID=
